# ==============================================================================
# GridLens Next.js Analytics Dashboard — Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real credentials.

# ------------------------------------------------------------------------------
# Option A: Local Native PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=sl_grid_warehouse
POSTGRES_USER=grid_analyst
POSTGRES_PASSWORD=your_secure_analyst_password_here

# ------------------------------------------------------------------------------
# Option B: Managed Supabase Cloud PostgreSQL (Phase 6 Modernization)
# ------------------------------------------------------------------------------
# Use least-privilege read-only role 'grid_analyst' with verified TLS (rejectUnauthorized: true).
# ANALYST_DATABASE_URL=postgresql://grid_analyst.<project-ref>:[YOUR-ANALYST-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://grid_analyst.<project-ref>:[YOUR-ANALYST-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# MONITORING_API_TOKEN=your_optional_monitoring_token_here

# Data Source Mode:
# 'hybrid'   - Attempts live PostgreSQL query first; falls back to verified static snapshots if DB is offline.
# 'live'     - Requires active PostgreSQL connection; errors if unreachable.
# 'snapshot' - Strictly offline mode using pre-computed historical snapshots.
DATA_SOURCE_MODE=hybrid

# Security & Execution Limits
QUERY_STATEMENT_TIMEOUT_MS=10000
MAX_QUERY_ROWS_LIMIT=5000
NODE_ENV=development
