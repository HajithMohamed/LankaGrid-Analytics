# ==============================================================================
# GridLens Next.js Analytics Dashboard — Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real credentials.

# Database Connection (Dedicated Read-Only Role)
# The dashboard operates strictly with least-privilege 'grid_analyst'.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=sl_grid_warehouse
POSTGRES_USER=grid_analyst
POSTGRES_PASSWORD=your_secure_analyst_password_here

# Optional: Full Connection String override
# DATABASE_URL=postgresql://grid_analyst:your_secure_analyst_password_here@localhost:5433/sl_grid_warehouse

# Data Source Mode:
# 'hybrid'   - Attempts live PostgreSQL query first; falls back to verified static snapshots if DB is offline.
# 'live'     - Requires active PostgreSQL connection; errors if unreachable.
# 'snapshot' - Strictly offline mode using pre-computed historical snapshots.
DATA_SOURCE_MODE=hybrid

# Security & Execution Limits
QUERY_STATEMENT_TIMEOUT_MS=5000
MAX_QUERY_ROWS_LIMIT=5000
NODE_ENV=development
