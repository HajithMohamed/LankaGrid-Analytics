# ==============================================================================
# Environment Configuration - National Electricity Grid Analytics Data Warehouse
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Option A: Local Native PostgreSQL / Local Service
# ------------------------------------------------------------------------------
# Note: Use 5433 if your local Windows PostgreSQL service runs on port 5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sl_grid_warehouse
POSTGRES_USER=grid_admin
POSTGRES_PASSWORD=grid_dev_password_change_me
POSTGRES_ETL_USER=grid_etl
POSTGRES_ETL_PASSWORD=grid_etl_dev_password_change_me
POSTGRES_ANALYST_USER=grid_analyst
POSTGRES_ANALYST_PASSWORD=grid_analyst_dev_password_change_me
POSTGRES_SSLMODE=disable

# ------------------------------------------------------------------------------
# Option B: Managed Supabase Cloud PostgreSQL (Phase 6 Modernization)
# ------------------------------------------------------------------------------
# When DATABASE_URL is set, Python ETL and Next.js automatically use it with SSL require.
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.leormbswimbnpixkkbbu.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.leormbswimbnpixkkbbu.supabase.co:5432/postgres

# Database Connection (Separate Test Database for local pytest runs)
POSTGRES_TEST_DB=sl_grid_warehouse_test

# Connection Pool Settings
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=30

# Application Environment (development | testing | production)
APP_ENV=development
LOG_LEVEL=INFO

# Data Ingestion and Storage Paths
DATA_RAW_DIR=data/raw
DATA_STAGING_DIR=data/staging
DATA_PROCESSED_DIR=data/processed
DATA_FIXTURES_DIR=tests/fixtures

# External APIs (NASA POWER, etc. - default public rate limits)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
CEB_PORTAL_URL=https://ceb.lk/
PUCSL_PORTAL_URL=https://www.pucsl.gov.lk/daily-generation-reports-2/

# Optional pgAdmin Configuration (Docker Compose)
PGADMIN_DEFAULT_EMAIL=admin@gridwarehouse.lk
PGADMIN_DEFAULT_PASSWORD=admin_dev_password
PGADMIN_PORT=5050
